{
  "specVersion": 2,
  "id": "xyz.clodex.rp-studio",
  "name": { "$t": "plugin.name" },
  "version": "1.5.1",
  "minAppVersion": "0.93.0",
  "entry": "entry.js",
  "author": "CLODEx",
  "description": { "$t": "plugin.description" },
  "releaseNotes": { "$t": "releaseNotes.1_5_1" },
  "localization": {
    "defaultLocale": "en",
    "resources": {
      "en": "locales/en.json",
      "ru": "locales/ru.json"
    }
  },
  "cover": "cover.png",
  "permissions": [
    "input",
    "message",
    "generate",
    "variable",
    "file",
    "network"
  ],
  "contributes": {
    "inputActions": [
      {
        "id": "toggle-studio",
        "label": { "$t": "actions.toggleStudio" },
        "icon": "icons/studio.png"
      },
      {
        "id": "ask-codex",
        "label": { "$t": "actions.askCodex" },
        "icon": "icons/codex.png"
      }
    ],
    "sidebar": [
      {
        "id": "open-studio",
        "label": { "$t": "actions.toggleStudio" }
      },
      {
        "id": "open-cradle",
        "label": { "$t": "actions.openCradle" }
      },
      {
        "id": "open-underworld",
        "label": { "$t": "actions.openUnderworld" }
      },
      {
        "id": "open-phone",
        "label": { "$t": "actions.openPhone" }
      },
      {
        "id": "open-forge",
        "label": { "$t": "actions.openForge" }
      },
      {
        "id": "sync-tracker",
        "label": { "$t": "actions.syncTracker" }
      },
      {
        "id": "generate-bg",
        "label": { "$t": "actions.generateSceneBg" }
      }
    ],
    "lastMessageActions": [
      {
        "id": "speak-last-turn",
        "label": { "$t": "actions.speakLast" },
        "icon": "icons/voice.png",
        "role": "character"
      },
      {
        "id": "sync-last-turn",
        "label": { "$t": "actions.syncTracker" },
        "icon": "icons/studio.png",
        "role": "character"
      }
    ],
    "htmlFragments": [
      {
        "id": "clodex-rp-hud",
        "src": "ui/hud.html",
        "mount": "/chat/body/end"
      },
      {
        "id": "clodex-rp-turn",
        "src": "ui/turn.html",
        "mount": "/messages/end?role=character&position=last"
      }
    ],
    "settings": {
      "schema": [
        {
          "type": "info",
          "text": { "$t": "settings.info" },
          "icon": "info"
        },
        {
          "type": "header",
          "label": { "$t": "settings.header.api" }
        },
        {
          "key": "apiKey",
          "type": "text",
          "label": { "$t": "settings.apiKey.label" },
          "placeholder": { "$t": "settings.apiKey.placeholder" },
          "description": { "$t": "settings.apiKey.desc" },
          "default": ""
        },
        {
          "key": "autoTrack",
          "type": "switch",
          "label": { "$t": "settings.autoTrack.label" },
          "description": { "$t": "settings.autoTrack.desc" },
          "default": true
        },
        {
          "key": "confirmPaid",
          "type": "switch",
          "label": { "$t": "settings.confirmPaid.label" },
          "description": { "$t": "settings.confirmPaid.desc" },
          "default": true
        },
        {
          "type": "header",
          "label": { "$t": "settings.header.modules" }
        },
        {
          "key": "enableVitals",
          "type": "switch",
          "label": { "$t": "settings.enableVitals.label" },
          "default": true
        },
        {
          "key": "enableAdultBio",
          "type": "switch",
          "label": { "$t": "settings.enableAdultBio.label" },
          "description": { "$t": "settings.enableAdultBio.desc" },
          "default": false
        },
        {
          "key": "injectContext",
          "type": "switch",
          "label": { "$t": "settings.injectContext.label" },
          "default": true
        },
        {
          "key": "bgDim",
          "type": "slider",
          "label": { "$t": "settings.bgDim.label" },
          "min": 0,
          "max": 80,
          "step": 5,
          "default": 35
        },
        {
          "type": "header",
          "label": { "$t": "settings.header.v13" }
        },
        {
          "key": "showInnerThoughts",
          "type": "switch",
          "label": { "$t": "settings.showInnerThoughts.label" },
          "default": true
        },
        {
          "key": "thoughtsBlurred",
          "type": "switch",
          "label": { "$t": "settings.thoughtsBlurred.label" },
          "description": { "$t": "settings.thoughtsBlurred.desc" },
          "default": true
        },
        {
          "key": "showSuggestedActions",
          "type": "switch",
          "label": { "$t": "settings.showSuggestedActions.label" },
          "default": true
        },
        {
          "key": "wikiEnabled",
          "type": "switch",
          "label": { "$t": "settings.wikiEnabled.label" },
          "description": { "$t": "settings.wikiEnabled.desc" },
          "default": true
        },
        {
          "key": "wikiEvery",
          "type": "slider",
          "label": { "$t": "settings.wikiEvery.label" },
          "description": { "$t": "settings.wikiEvery.desc" },
          "min": 4,
          "max": 20,
          "step": 1,
          "default": 8
        }
      ]
    }
  }
}
